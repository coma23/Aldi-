# Database — SQLite works out of the box for local dev.
# For production, use a hosted Postgres/MySQL/LibSQL database and update
# prisma/schema.prisma + src/lib/db.ts accordingly (see README.md).
DATABASE_URL="file:./dev.db"

# Stripe — https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_..."
# https://dashboard.stripe.com/webhooks — required for orders to be
# marked as paid automatically.
STRIPE_WEBHOOK_SECRET="whsec_..."
